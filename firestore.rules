rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function eProprioUsuario(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function perfilLegado(userId) {
      let perfil = get(/databases/$(database)/documents/usuarios/$(userId)).data;
      return eProprioUsuario(userId) && perfil.userId == userId
             && perfil.tipoConta in ['apontamento', 'estoque']
             && perfil.get('schemaVersion', 0) in [0, 1];
    }

    function perfilAtual() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function idValido(id) { return id is string && id.matches('^[a-zA-Z0-9_-]{1,128}$'); }
    function itemObraValido(ids, indice) { return ids.size() <= indice || idValido(ids[indice]); }
    function obrasValidas(ids) {
      return ids is list && ids.size() <= 30 && ids.toSet().size() == ids.size()
        && itemObraValido(ids, 0) && itemObraValido(ids, 1) && itemObraValido(ids, 2)
        && itemObraValido(ids, 3) && itemObraValido(ids, 4) && itemObraValido(ids, 5)
        && itemObraValido(ids, 6) && itemObraValido(ids, 7) && itemObraValido(ids, 8)
        && itemObraValido(ids, 9) && itemObraValido(ids, 10) && itemObraValido(ids, 11)
        && itemObraValido(ids, 12) && itemObraValido(ids, 13) && itemObraValido(ids, 14)
        && itemObraValido(ids, 15) && itemObraValido(ids, 16) && itemObraValido(ids, 17)
        && itemObraValido(ids, 18) && itemObraValido(ids, 19) && itemObraValido(ids, 20)
        && itemObraValido(ids, 21) && itemObraValido(ids, 22) && itemObraValido(ids, 23)
        && itemObraValido(ids, 24) && itemObraValido(ids, 25) && itemObraValido(ids, 26)
        && itemObraValido(ids, 27) && itemObraValido(ids, 28) && itemObraValido(ids, 29);
    }
    function hierarquico(userId) {
      let perfil = perfilAtual();
      return request.auth != null && perfil.get('schemaVersion', 0) == 2
        && perfil.userId == request.auth.uid && perfil.espacoId == userId
        && idValido(perfil.espacoId)
        && perfil.nivel in ['tecnico', 'engenheiro', 'coordenador', 'gestor', 'dev']
        && perfil.tipoConta in ['apontamento', 'estoque']
        && perfil.obraIds is list && perfil.obraIds.size() <= 30
        && (perfil.nivel == 'dev' ? perfil.superiorId == null
          : idValido(perfil.superiorId) && perfil.superiorId != request.auth.uid);
    }
    function perfilPermitido(userId) { return perfilLegado(userId) || hierarquico(userId); }
    // Capacidades usadas sempre junto de acessoObra; a validação do escopo/perfil fica naquela função.
    function gerenciar(userId) {
      let perfil = perfilAtual();
      return perfil.get('schemaVersion', 0) == 2 ? perfil.nivel in ['tecnico', 'engenheiro', 'dev'] : eProprioUsuario(userId);
    }
    function apontar(userId) {
      let perfil = perfilAtual();
      return perfil.get('schemaVersion', 0) == 2 ? perfil.nivel in ['tecnico', 'dev'] : eProprioUsuario(userId);
    }
    function gerenciarKits(userId) {
      let perfil = perfilAtual();
      return perfil.get('schemaVersion', 0) == 2
        ? (perfil.nivel in ['engenheiro', 'coordenador'] || (perfil.nivel in ['tecnico', 'dev'] && perfil.tipoConta == 'estoque'))
        : perfilEstoque(userId);
    }
    function mapaEditavel(data) {
      let perfil = perfilAtual();
      return perfil.get('schemaVersion', 0) != 2 || perfil.nivel != 'engenheiro'
        || data.get('criadoPor', '') == request.auth.uid;
    }
    function kitEditavel(data, userId) {
      let perfil = perfilAtual();
      return perfil.get('schemaVersion', 0) != 2 || perfil.nivel != 'engenheiro'
        || mapaEditavel(get(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraDoKit(data))/mapas/$(data.mapaId)).data);
    }
    function obraAtribuida(userId, obraId) {
      return hierarquico(userId) && (perfilAtual().nivel in ['gestor', 'dev'] || obraId in perfilAtual().obraIds);
    }
    function devDoEspaco(espacoId) { return hierarquico(espacoId) && perfilAtual().nivel == 'dev'; }
    function gerenciarLegendas(userId) { return perfilLegado(userId) || devDoEspaco(userId); }
    function superiorValido(data) {
      let superior = getAfter(/databases/$(database)/documents/usuarios/$(data.superiorId)).data;
      return superior.schemaVersion == 2 && superior.userId == data.superiorId && superior.espacoId == data.espacoId
        && ((data.nivel == 'tecnico' && superior.nivel == 'engenheiro')
          || (data.nivel == 'engenheiro' && superior.nivel == 'coordenador')
          || (data.nivel == 'coordenador' && superior.nivel == 'gestor')
          || (data.nivel == 'gestor' && superior.nivel == 'dev'));
    }
    function perfilAdministravel(data, userId) {
      return data.schemaVersion == 2 && data.userId == userId && userId != request.auth.uid
        && data.tipoConta in ['apontamento', 'estoque'] && data.nivel in ['tecnico', 'engenheiro', 'coordenador', 'gestor']
        && obrasValidas(data.obraIds)
        && idValido(data.superiorId) && data.superiorId != userId && superiorValido(data);
    }

    function perfilEstoque(userId) {
      let perfil = perfilAtual();
      return perfil.tipoConta == 'estoque' && (perfil.get('schemaVersion', 0) == 2 ? perfil.espacoId == userId : eProprioUsuario(userId));
    }

    function schemaAtual(data) {
      return data.schemaVersion == 1;
    }

    function schemaConhecido(data) {
      return data.get('schemaVersion', 0) in [0, 1];
    }

    function acessoObra(userId, obraId) {
      let caminho = /databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId);
      return (perfilLegado(userId) && ((exists(caminho) && get(caminho).data.userId == userId)
        || (obraId == 'obra-principal' && !exists(caminho))))
        || (obraAtribuida(userId, obraId) && exists(caminho) && get(caminho).data.userId == userId);
    }

    function plantaDoDocumento(data) { return data.get('plantaId', 'planta-principal'); }

    function unidadesDaPlanta(userId, obraId, plantaId) {
      let planta = get(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/plantas/$(plantaId)).data;
      return planta.templateId == 'original-v1' ? unidadesLegadas() : get(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/templates/$(planta.templateId)).data.unidadeIds;
    }

    function plantaPermitida(userId, obraId, plantaId) {
      return plantaId == 'planta-principal'
        || exists(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/plantas/$(plantaId));
    }

    function unidadesLegadas() { return 'bloco-01-101,bloco-01-001,bloco-01-102,bloco-01-002,bloco-01-103,bloco-01-003,bloco-01-104,bloco-01-004,bloco-01-105,bloco-01-005,bloco-01-106,bloco-01-006,bloco-01-107,bloco-01-007,bloco-01-108,bloco-01-008,bloco-02-101,bloco-02-001,bloco-02-102,bloco-02-002,bloco-02-103,bloco-02-003,bloco-02-104,bloco-02-004,bloco-02-105,bloco-02-005,bloco-02-106,bloco-02-006,bloco-02-107,bloco-02-007,bloco-02-108,bloco-02-008,bloco-03-101,bloco-03-001,bloco-03-102,bloco-03-002,bloco-03-103,bloco-03-003,bloco-03-104,bloco-03-004,bloco-03-105,bloco-03-005,bloco-03-106,bloco-03-006,bloco-03-107,bloco-03-007,bloco-03-108,bloco-03-008,bloco-04-101,bloco-04-001,bloco-04-102,bloco-04-002,bloco-04-103,bloco-04-003,bloco-04-104,bloco-04-004,bloco-04-105,bloco-04-005,bloco-04-106,bloco-04-006,bloco-05-101,bloco-05-001,bloco-05-102,bloco-05-002,bloco-05-103,bloco-05-003,bloco-05-104,bloco-05-004,bloco-05-105,bloco-05-005,bloco-05-106,bloco-05-006,bloco-05-107,bloco-05-007,bloco-05-108,bloco-05-008,bloco-06-101,bloco-06-001,bloco-06-102,bloco-06-002,bloco-06-103,bloco-06-003,bloco-06-104,bloco-06-004,bloco-06-105,bloco-06-005,bloco-06-106,bloco-06-006,bloco-07-101,bloco-07-001,bloco-07-102,bloco-07-002,bloco-07-103,bloco-07-003,bloco-07-104,bloco-07-004,bloco-07-105,bloco-07-005,bloco-07-106,bloco-07-006'.split(','); }

    function unidadesPermitidas(ids, userId, obraId, plantaId) {
      return ids.size() <= 1000 && (plantaId == 'planta-principal'
        ? ids.hasOnly(unidadesLegadas()) : ids.hasOnly(unidadesDaPlanta(userId, obraId, plantaId)));
    }

    // Compatibilidade histórica: mesmo ID de OBRA_LEGADA_ID em config/dados.ts.
    // Não deve acompanhar uma mudança da obra padrão de inicialização.
    function obraDoKit(data) {
      return data.get('obraId', 'obra-principal');
    }

    function nomeValido(data, limite) {
      return data.nome is string && data.nome.trim().size() > 0 && data.nome.size() <= limite;
    }

    function legendaValida(data, userId) {
      return schemaAtual(data) && data.userId == userId && nomeValido(data, 48)
             && data.cor is string && data.cor.matches('^#[0-9a-fA-F]{6}$')
             && data.get('categoria', 'outro') in ['nao-iniciado', 'andamento', 'concluido', 'bloqueado', 'outro'];
    }

    function mapaManualValido(data) {
      return !('kitId' in data)
             && data.get('tipo', 'manual') == 'manual'
             && data.get('kitUnidadeIds', []) == [];
    }

    function mapaKitValido(data, userId, obraId, mapaId) {
      let kit = getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data;
      return (perfilEstoque(userId) || hierarquico(userId)) && data.tipo == 'kit'
             && plantaDoDocumento(kit) == plantaDoDocumento(data)
             && kit.userId == userId && obraDoKit(kit) == obraId
             && kit.mapaId == mapaId && kit.nome == data.nome
             && kit.unidadeIds == data.kitUnidadeIds;
    }

    function mapaValido(data, userId, obraId, mapaId) {
      return schemaAtual(data) && data.userId == userId && data.obraId == obraId
             && (data.get('equipeId', '') == '' || exists(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/equipes/$(data.equipeId)))
             && plantaPermitida(userId, obraId, plantaDoDocumento(data))
             && unidadesPermitidas(data.marcacoes.keys(), userId, obraId, plantaDoDocumento(data))
             && nomeValido(data, 80) && data.marcacoes is map
             && (mapaManualValido(data) || mapaKitValido(data, userId, obraId, mapaId));
    }

    function mapaSemVinculo(userId, obraId, mapaId, data) {
      return !('kitId' in data)
             || !existsAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId))
             || obraDoKit(getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data) != obraId
             || getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data.mapaId != mapaId;
    }

    function eventoDoMapa(data, userId, obraId, mapaId, acoes) {
      let evento = getAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/historico/$(data.ultimoEventoId)).data;
      return evento.criadoEm == request.time && evento.get('autorId', userId) == request.auth.uid
        && evento.userId == userId && evento.obraId == obraId && evento.mapaId == mapaId
        && evento.acao in acoes;
    }

    function atualizacaoEstruturalKit(data, anterior, userId) {
      let kit = getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data;
      return gerenciarKits(userId) && mapaEditavel(anterior)
        && data.diff(anterior).affectedKeys().hasOnly(['schemaVersion', 'nome', 'kitUnidadeIds', 'atualizadoEm', 'atualizadoPor'])
        && kit.atualizadoEm == request.time && kit.atualizadoPor == request.auth.uid;
    }

    function kitValido(data, userId, kitId) {
      let mapa = getAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(data.obraId)/mapas/$(data.mapaId)).data;
      return schemaAtual(data) && data.userId == userId && nomeValido(data, 80) && mapaEditavel(mapa)
             && acessoObra(userId, data.obraId)
             && plantaDoDocumento(mapa) == plantaDoDocumento(data)
             && data.get('atualizadoPor', userId) == request.auth.uid
             && data.obraId is string && data.obraId.matches('^[^/]+$')
             && data.materiais is list && data.materiais.size() > 0
             && data.unidadeIds is list && unidadesPermitidas(data.unidadeIds, userId, data.obraId, plantaDoDocumento(data))
             && data.unidadeIds.toSet().size() == data.unidadeIds.size()
             && data.mapaId is string && data.mapaId.size() > 0
             && mapa.userId == userId && mapa.obraId == data.obraId
             && mapa.tipo == 'kit' && mapa.kitId == kitId
             && mapa.nome == data.nome && mapa.kitUnidadeIds == data.unidadeIds;
    }

    match /usuarios/{userId} {
      allow read: if eProprioUsuario(userId) || devDoEspaco(resource.data.espacoId);
      // Criação, migração de versão, mudança de nível e exclusão exigem IAM administrativo.
      allow write: if false;
      // DEV administra somente perfis já provisionados no seu espaço. Nunca o próprio ou outro DEV.
      allow update: if devDoEspaco(resource.data.espacoId) && resource.data.schemaVersion == 2
        && resource.data.nivel != 'dev'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tipoConta', 'superiorId', 'obraIds'])
        && perfilAdministravel(request.resource.data, userId);
    }

    match /usuarios/{userId}/obras/{obraId} {
      allow get: if acessoObra(userId, obraId);
      allow list: if (perfilLegado(userId) || obraAtribuida(userId, obraId)) && resource.data.userId == userId;
      // Obras são provisionadas administrativamente. O cliente só atualiza o marcador de migração.
      allow create: if false;
      allow update: if gerenciar(userId) && acessoObra(userId, obraId) && resource.data.userId == userId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'atualizadoEm'])
                    && schemaConhecido(resource.data)
                    && schemaAtual(request.resource.data)
                    && request.resource.data.userId == userId && nomeValido(request.resource.data, 100);
      allow delete: if false;
    }

    match /usuarios/{userId}/obras/{obraId}/{catalogo}/{id} {
      allow read: if catalogo in ['plantas', 'templates', 'equipes'] && acessoObra(userId, obraId);
      allow write: if false;
    }

    match /usuarios/{userId}/obras/{obraId}/mapas/{mapaId} {
      allow get: if acessoObra(userId, obraId)
                 && (!exists(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(mapaId))
                     || resource.data.userId == userId);
      allow list: if acessoObra(userId, obraId) && resource.data.userId == userId;
      allow create: if acessoObra(userId, obraId)
        && ('kitId' in request.resource.data ? gerenciarKits(userId) : gerenciar(userId))
        && (perfilLegado(userId) || (request.resource.data.criadoPor == request.auth.uid
          && request.resource.data.marcacoes == {}
          && request.resource.data.atualizadoPor == request.auth.uid && request.resource.data.atualizadoEm == request.time
          && ('kitId' in request.resource.data || eventoDoMapa(request.resource.data, userId, obraId, mapaId, ['criar']))))
        && mapaValido(request.resource.data, userId, obraId, mapaId);
      allow update: if acessoObra(userId, obraId) && resource.data.userId == userId
                    && (perfilLegado(userId) || (request.resource.data.atualizadoPor == request.auth.uid
                      && request.resource.data.atualizadoEm == request.time
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['schemaVersion', 'nome', 'equipeId', 'marcacoes', 'kitUnidadeIds', 'atualizadoEm', 'atualizadoPor', 'ultimoEventoId'])
                      && ((('kitId' in resource.data) && atualizacaoEstruturalKit(request.resource.data, resource.data, userId))
                        || (apontar(userId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['marcacoes', 'atualizadoEm', 'atualizadoPor', 'ultimoEventoId'])
                          && eventoDoMapa(request.resource.data, userId, obraId, mapaId, ['unidade', 'marcacoes']))
                        || (!('kitId' in resource.data) && gerenciar(userId) && mapaEditavel(resource.data)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'equipeId', 'atualizadoEm', 'atualizadoPor', 'ultimoEventoId'])
                          && eventoDoMapa(request.resource.data, userId, obraId, mapaId, ['renomear', 'equipe'])))))
                    && plantaDoDocumento(request.resource.data) == plantaDoDocumento(resource.data)
                    && schemaConhecido(resource.data)
                    && mapaValido(request.resource.data, userId, obraId, mapaId)
                    && (mapaSemVinculo(userId, obraId, mapaId, resource.data)
                        || request.resource.data.get('kitId', '') == resource.data.kitId);
      allow delete: if acessoObra(userId, obraId) && resource.data.userId == userId
                    && ('kitId' in resource.data ? gerenciarKits(userId) : gerenciar(userId)) && mapaEditavel(resource.data)
                    && schemaConhecido(resource.data)
                    && mapaSemVinculo(userId, obraId, mapaId, resource.data);
    }

    function contextoValido(data, userId, obraId, mapaId, unidadeId) {
      let mapa = get(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(mapaId)).data;
      return data.keys().hasOnly(['schemaVersion', 'userId', 'obraId', 'plantaId', 'mapaId', 'unidadeId', 'observacao',
                                  'responsavel', 'atualizadoEm', 'atualizadoPor', 'ultimoEventoId'])
        && schemaAtual(data) && data.userId == userId && data.obraId == obraId && data.mapaId == mapaId
        && data.unidadeId == unidadeId && unidadesPermitidas([unidadeId], userId, obraId, plantaDoDocumento(data))
        && mapa.userId == userId && mapa.obraId == obraId && schemaConhecido(mapa)
        && plantaDoDocumento(data) == plantaDoDocumento(mapa)
        && data.observacao is string && data.observacao.size() <= 240
        && data.responsavel is string && data.responsavel.size() <= 80
        && data.atualizadoEm == request.time && data.atualizadoPor == request.auth.uid
        && data.ultimoEventoId is string && data.ultimoEventoId.size() > 0;
    }

    function eventoDoContexto(data, userId, obraId, unidadeId) {
      let evento = getAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/historico/$(data.ultimoEventoId)).data;
      return evento.acao == 'contexto' && evento.criadoEm == request.time
        && evento.get('autorId', userId) == request.auth.uid
        && evento.userId == userId && evento.obraId == obraId && evento.mapaId == data.mapaId
        && evento.unidadeIds == [unidadeId] && plantaDoDocumento(evento) == plantaDoDocumento(data)
        && evento.depois.observacao == data.observacao && evento.depois.responsavel == data.responsavel;
    }

    match /usuarios/{userId}/obras/{obraId}/mapas/{mapaId}/contextos/{unidadeId} {
      allow read: if acessoObra(userId, obraId) && (!exists(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(mapaId)/contextos/$(unidadeId))
        || resource.data.userId == userId);
      allow create, update: if apontar(userId) && acessoObra(userId, obraId) && contextoValido(request.resource.data, userId, obraId, mapaId, unidadeId)
        && eventoDoContexto(request.resource.data, userId, obraId, unidadeId);
      allow delete: if false;
    }

    match /usuarios/{userId}/legendas/{legendaId} {
      allow read: if perfilPermitido(userId) && resource.data.userId == userId;
      allow create: if gerenciarLegendas(userId) && legendaValida(request.resource.data, userId);
      allow update: if gerenciarLegendas(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && legendaValida(request.resource.data, userId);
      allow delete: if gerenciarLegendas(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data);
    }

    match /usuarios/{userId}/kits/{kitId} {
      allow read: if (perfilEstoque(userId) || hierarquico(userId)) && resource.data.userId == userId && acessoObra(userId, obraDoKit(resource.data));
      allow create: if gerenciarKits(userId) && kitValido(request.resource.data, userId, kitId);
      allow update: if gerenciarKits(userId) && resource.data.userId == userId
                    && plantaDoDocumento(request.resource.data) == plantaDoDocumento(resource.data)
                    && schemaConhecido(resource.data)
                    && request.resource.data.obraId == obraDoKit(resource.data)
                    && kitValido(request.resource.data, userId, kitId)
                    && (resource.data.get('mapaId', '') == ''
                        || request.resource.data.mapaId == resource.data.mapaId);
      allow delete: if gerenciarKits(userId) && resource.data.userId == userId && acessoObra(userId, obraDoKit(resource.data)) && kitEditavel(resource.data, userId)
                    && schemaConhecido(resource.data)
                    && !existsAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraDoKit(resource.data))/mapas/$(resource.data.mapaId));
    }

    function eventoEstruturado(data, userId, obraId) {
      return data.keys().hasOnly(['schemaVersion', 'userId', 'autorId', 'obraId', 'plantaId', 'mapaId', 'mapaNome', 'acao',
                                  'unidadeIds', 'antes', 'depois', 'nomeAnterior', 'nomeAtual', 'criadoEm'])
        && schemaAtual(data) && data.userId == userId && data.obraId == obraId
        && data.get('autorId', userId) == request.auth.uid
        && data.criadoEm == request.time
        && data.mapaId is string && data.mapaId.matches('^[^/]+$')
        && data.mapaNome is string && data.mapaNome.size() <= 80
        && data.unidadeIds is list && data.unidadeIds.size() <= 1000
        && data.unidadeIds.toSet().size() == data.unidadeIds.size()
        && data.antes is map && data.depois is map && data.antes.size() <= 1000 && data.depois.size() <= 1000;
    }

    function eventoUnidade(data, anterior, atual) {
      let id = data.unidadeIds[0];
      return data.unidadeIds.size() == 1 && id is string
        && id.matches('^[a-zA-Z0-9_-]{1,128}$')
        && data.antes.keys().hasOnly([id]) && data.antes.size() == 1
        && data.depois.keys().hasOnly([id]) && data.depois.size() == 1
        && data.antes[id] == anterior.marcacoes.get(id, null)
        && data.depois[id] == atual.marcacoes.get(id, null)
        && data.antes[id] != data.depois[id]
        && (data.depois[id] == null || (data.depois[id] is string && data.depois[id].size() > 0 && data.depois[id].size() <= 128))
        && atual.marcacoes.diff(anterior.marcacoes).affectedKeys().hasOnly([id]);
    }

    function eventoEdicao(data, userId, obraId, eventoId) {
      let anterior = get(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(data.mapaId)).data;
      let atual = getAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(data.mapaId)).data;
      return anterior.userId == userId && schemaConhecido(anterior)
        && (data.acao in ['unidade', 'marcacoes'] ? apontar(userId) : gerenciar(userId) && mapaEditavel(anterior))
        && plantaDoDocumento(data) == plantaDoDocumento(anterior)
        && atual.userId == userId && atual.obraId == obraId && atual.ultimoEventoId == eventoId
        && data.mapaNome == anterior.nome && data.nomeAnterior == anterior.nome && data.nomeAtual == atual.nome
        && (!('kitId' in anterior) || perfilEstoque(userId) || (hierarquico(userId) && data.acao in ['unidade', 'marcacoes']))
        && ((data.acao == 'unidade' && atual.nome == anterior.nome && eventoUnidade(data, anterior, atual))
          || (data.acao == 'marcacoes' && atual.nome == anterior.nome
            && data.antes == anterior.marcacoes && data.depois == atual.marcacoes
            && data.antes != data.depois
            && data.unidadeIds.toSet() == atual.marcacoes.diff(anterior.marcacoes).affectedKeys())
          || (data.acao == 'equipe' && atual.nome == anterior.nome && atual.marcacoes == anterior.marcacoes
            && data.unidadeIds == [] && data.antes == {'equipeId': anterior.get('equipeId', '')}
            && data.depois == {'equipeId': atual.equipeId} && data.antes != data.depois)
          || (data.acao == 'renomear' && atual.nome != anterior.nome && atual.marcacoes == anterior.marcacoes
            && data.antes == {} && data.depois == {} && data.unidadeIds == []));
    }

    function eventoCriacao(data, userId, obraId, eventoId) {
      let caminho = /databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(data.mapaId);
      let atual = getAfter(caminho).data;
      return !exists(caminho) && atual.userId == userId && atual.obraId == obraId
        && plantaDoDocumento(data) == plantaDoDocumento(atual)
        && atual.ultimoEventoId == eventoId && data.mapaNome == atual.nome && data.nomeAtual == atual.nome
        && data.nomeAnterior == null && data.unidadeIds == [] && data.antes == {} && data.depois == {};
    }

    function eventoExclusao(data, userId, obraId) {
      let caminho = /databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(data.mapaId);
      let anterior = get(caminho).data;
      return anterior.userId == userId && schemaConhecido(anterior) && !existsAfter(caminho) && mapaEditavel(anterior)
        && plantaDoDocumento(data) == plantaDoDocumento(anterior)
        && (!('kitId' in anterior) || perfilEstoque(userId))
        && data.mapaNome == anterior.nome && data.nomeAnterior == anterior.nome && data.nomeAtual == null
        && data.antes == {} && data.depois == {} && data.unidadeIds == [];
    }

    function eventoContexto(data, userId, obraId, eventoId) {
      let unidadeId = data.unidadeIds[0];
      let caminho = /databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(data.mapaId)/contextos/$(unidadeId);
      let anterior = exists(caminho) ? get(caminho).data : {};
      let atual = getAfter(caminho).data;
      return data.unidadeIds.size() == 1
        && plantaDoDocumento(data) == plantaDoDocumento(atual)
        && data.antes.keys().hasOnly(['observacao', 'responsavel']) && data.depois.keys().hasOnly(['observacao', 'responsavel'])
        && atual.userId == userId && atual.obraId == obraId && atual.mapaId == data.mapaId
        && atual.unidadeId == unidadeId && atual.ultimoEventoId == eventoId
        && data.antes.observacao == anterior.get('observacao', '') && data.antes.responsavel == anterior.get('responsavel', '')
        && data.depois.observacao == atual.observacao && data.depois.responsavel == atual.responsavel
        && data.antes != data.depois;
    }

    match /usuarios/{userId}/obras/{obraId}/historico/{eventoId} {
      allow read: if acessoObra(userId, obraId) && resource.data.userId == userId && resource.data.obraId == obraId;
      allow create: if acessoObra(userId, obraId) && eventoEstruturado(request.resource.data, userId, obraId)
        && (request.resource.data.acao in ['unidade', 'marcacoes', 'contexto'] ? apontar(userId) : gerenciar(userId))
        && (request.resource.data.acao == 'criar' ? eventoCriacao(request.resource.data, userId, obraId, eventoId)
          : request.resource.data.acao == 'excluir' ? eventoExclusao(request.resource.data, userId, obraId)
          : request.resource.data.acao == 'contexto' ? eventoContexto(request.resource.data, userId, obraId, eventoId)
          : request.resource.data.acao in ['unidade', 'marcacoes', 'renomear', 'equipe'] && eventoEdicao(request.resource.data, userId, obraId, eventoId));
      allow update, delete: if false;
    }

    // Fontes de migracao preservadas. Nenhum cliente pode apaga-las ou altera-las.
    match /obras/{obraId}/mapas/{mapaId} {
      allow read: if request.auth != null && perfilPermitido(request.auth.uid)
                  && resource.data.criadoPor == request.auth.uid;
      allow write: if false;
    }
  }
}
