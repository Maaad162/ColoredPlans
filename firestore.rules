rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function eProprioUsuario(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function perfilPermitido(userId) {
      let perfil = get(/databases/$(database)/documents/usuarios/$(userId)).data;
      return eProprioUsuario(userId) && perfil.userId == userId
             && perfil.tipoConta in ['apontamento', 'estoque']
             && perfil.get('schemaVersion', 0) in [0, 1];
    }

    function perfilEstoque(userId) {
      return perfilPermitido(userId)
             && get(/databases/$(database)/documents/usuarios/$(userId)).data.tipoConta == 'estoque';
    }

    function schemaAtual(data) {
      return data.schemaVersion == 1;
    }

    function schemaConhecido(data) {
      return data.get('schemaVersion', 0) in [0, 1];
    }

    // Compatibilidade histórica: mesmo ID de OBRA_LEGADA_ID em config/dados.ts.
    // Não deve acompanhar uma mudança da obra padrão de inicialização.
    function obraDoKit(data) {
      return data.get('obraId', 'obra-principal');
    }

    function nomeValido(data, limite) {
      return data.nome is string && data.nome.trim().size() > 0 && data.nome.size() <= limite;
    }

    function legendaValida(data, userId) {
      return schemaAtual(data) && data.userId == userId && nomeValido(data, 48)
             && data.cor is string && data.cor.matches('^#[0-9a-fA-F]{6}$');
    }

    function mapaManualValido(data) {
      return !('kitId' in data)
             && data.get('tipo', 'manual') == 'manual'
             && data.get('kitUnidadeIds', []) == [];
    }

    function mapaKitValido(data, userId, obraId, mapaId) {
      let kit = getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data;
      return perfilEstoque(userId) && data.tipo == 'kit'
             && kit.userId == userId && obraDoKit(kit) == obraId
             && kit.mapaId == mapaId && kit.nome == data.nome
             && kit.unidadeIds == data.kitUnidadeIds;
    }

    function mapaValido(data, userId, obraId, mapaId) {
      return schemaAtual(data) && data.userId == userId && data.obraId == obraId
             && nomeValido(data, 80) && data.marcacoes is map
             && (mapaManualValido(data) || mapaKitValido(data, userId, obraId, mapaId));
    }

    function mapaSemVinculo(userId, obraId, mapaId, data) {
      return !('kitId' in data)
             || !existsAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId))
             || obraDoKit(getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data) != obraId
             || getAfter(/databases/$(database)/documents/usuarios/$(userId)/kits/$(data.kitId)).data.mapaId != mapaId;
    }

    function kitValido(data, userId, kitId) {
      let mapa = getAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(data.obraId)/mapas/$(data.mapaId)).data;
      return schemaAtual(data) && data.userId == userId && nomeValido(data, 80)
             && data.obraId is string && data.obraId.matches('^[^/]+$')
             && data.materiais is list && data.materiais.size() > 0
             && data.unidadeIds is list && data.unidadeIds.size() <= 100
             && data.unidadeIds.toSet().size() == data.unidadeIds.size()
             && data.mapaId is string && data.mapaId.size() > 0
             && mapa.userId == userId && mapa.obraId == data.obraId
             && mapa.tipo == 'kit' && mapa.kitId == kitId
             && mapa.nome == data.nome && mapa.kitUnidadeIds == data.unidadeIds;
    }

    match /usuarios/{userId} {
      allow read: if eProprioUsuario(userId);
      // Provisionamento exclusivo pelo Console/Admin SDK com IAM administrativo.
      // Inclui create/update/delete, merge, substituicao, lotes e transacoes.
      // Nenhum setor ou claim de cliente concede escrita neste documento.
      allow write: if false;
    }

    match /usuarios/{userId}/obras/{obraId} {
      allow read: if perfilPermitido(userId);
      allow create: if perfilPermitido(userId) && schemaAtual(request.resource.data)
                    && request.resource.data.userId == userId && nomeValido(request.resource.data, 100);
      allow update: if perfilPermitido(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && schemaAtual(request.resource.data)
                    && request.resource.data.userId == userId && nomeValido(request.resource.data, 100);
      allow delete: if false;
    }

    match /usuarios/{userId}/obras/{obraId}/mapas/{mapaId} {
      allow get: if perfilPermitido(userId)
                 && (!exists(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraId)/mapas/$(mapaId))
                     || resource.data.userId == userId);
      allow list: if perfilPermitido(userId) && resource.data.userId == userId;
      allow create: if perfilPermitido(userId) && mapaValido(request.resource.data, userId, obraId, mapaId);
      allow update: if perfilPermitido(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && mapaValido(request.resource.data, userId, obraId, mapaId)
                    && (mapaSemVinculo(userId, obraId, mapaId, resource.data)
                        || request.resource.data.get('kitId', '') == resource.data.kitId);
      allow delete: if perfilPermitido(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && mapaSemVinculo(userId, obraId, mapaId, resource.data);
    }

    match /usuarios/{userId}/legendas/{legendaId} {
      allow read: if perfilPermitido(userId) && resource.data.userId == userId;
      allow create: if perfilPermitido(userId) && legendaValida(request.resource.data, userId);
      allow update: if perfilPermitido(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && legendaValida(request.resource.data, userId);
      allow delete: if perfilPermitido(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data);
    }

    match /usuarios/{userId}/kits/{kitId} {
      allow read: if perfilEstoque(userId) && resource.data.userId == userId;
      allow create: if perfilEstoque(userId) && kitValido(request.resource.data, userId, kitId);
      allow update: if perfilEstoque(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && request.resource.data.obraId == obraDoKit(resource.data)
                    && kitValido(request.resource.data, userId, kitId)
                    && (resource.data.get('mapaId', '') == ''
                        || request.resource.data.mapaId == resource.data.mapaId);
      allow delete: if perfilEstoque(userId) && resource.data.userId == userId
                    && schemaConhecido(resource.data)
                    && !existsAfter(/databases/$(database)/documents/usuarios/$(userId)/obras/$(obraDoKit(resource.data))/mapas/$(resource.data.mapaId));
    }

    // Fontes de migracao preservadas. Nenhum cliente pode apaga-las ou altera-las.
    match /obras/{obraId}/mapas/{mapaId} {
      allow read: if request.auth != null && perfilPermitido(request.auth.uid)
                  && resource.data.criadoPor == request.auth.uid;
      allow write: if false;
    }
  }
}
